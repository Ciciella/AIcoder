{
	"name": "claude-dev-china",
	"displayName": "AI Code: Cline, Chat, Deepseek, 中文版",
	"description": "在您的IDE中自动编码代理，能够在您的许可下创建/编辑文件、执行命令等等。支持deepseek模型",
	"version": "4.0.10",
	"icon": "assets/icons/icon.png",
	"engines": {
		"vscode": "^1.84.0"
	},
	"author": {
		"name": "AI Code Bot Inc."
	},
	"license": "Apache-2.0",
	"publisher": "tianguaduizhang",
	"repository": {
		"type": "git",
		"url": "https://github.com/Ciciella/AI-Code"
	},
	"homepage": "https://github.com/Ciciella/AI-Code",
	"categories": [
		"AI",
		"Chat",
		"Programming Languages",
		"Education",
		"Snippets",
		"Testing"
	],
	"keywords": [
		"cline",
		"claude",
		"dev",
		"mcp",
		"openrouter",
		"coding",
		"agent",
		"autonomous",
		"chatgpt",
		"sonnet",
		"ai",
		"llama",
		"deepseek",
		"qinghua",
		"zhipu",
		"aicode",
		"ai code",
		"lingma",
		"roo code",
		"roocode"
	],
	"activationEvents": [
		"onLanguage",
		"onUri",
		"onStartupFinished",
		"workspaceContains:evals.env"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"icons": {
			"ai-code-icon": {
				"description": "ai code",
				"default": {
					"fontPath": "assets/icons/cline-bot.woff",
					"fontCharacter": "\\e900"
				}
			}
		},
		"walkthroughs": [
			{
				"id": "AICodeWalkthrough",
				"title": "认识 AI Code，你的新编程搭档",
				"description": "AI Code 像开发者一样编码，因为它像开发者一样思考。以下是 5 种使用方式：",
				"steps": [
					{
						"id": "welcome",
						"title": "从一个目标开始，而不仅是一个提示",
						"description": "告诉 AI Code 你想要实现什么。它会规划、提问，然后编码，就像真正的搭档一样。",
						"media": {
							"markdown": "walkthrough/step1.md"
						}
					},
					{
						"id": "learn",
						"title": "让 AI Code 了解你的代码库",
						"description": "将 AI Code 指向你的项目。它会建立理解，做出智能的、基于上下文的修改。",
						"media": {
							"markdown": "walkthrough/step2.md"
						}
					},
					{
						"id": "advanced-features",
						"title": "始终使用最佳 AI 模型",
						"description": "AI Code 为你提供最先进的 AI 能力，连接顶级模型（Anthropic、Gemini、OpenAI 等）。",
						"media": {
							"markdown": "walkthrough/step3.md"
						}
					},
					{
						"id": "mcp",
						"title": "使用强大工具扩展 (MCP)",
						"description": "连接数据库、API，或在 MCP 市场中发现新功能。",
						"media": {
							"markdown": "walkthrough/step4.md"
						}
					},
					{
						"id": "getting-started",
						"title": "你始终掌控全局",
						"description": "审查 AI Code 的计划和差异。在更改发生前予以批准。没有意外。",
						"media": {
							"markdown": "walkthrough/step5.md"
						},
						"content": {
							"path": "walkthrough/step5.md"
						}
					}
				]
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "ai-code-dev-ActivityBar",
					"title": "AI Code",
					"icon": "assets/icons/icon.svg"
				}
			]
		},
		"views": {
			"ai-code-dev-ActivityBar": [
				{
					"type": "webview",
					"id": "ai-code-dev.SidebarProvider",
					"name": "",
					"icon": "assets/icons/icon.svg"
				}
			]
		},
		"commands": [
			{
				"command": "aiCode.plusButtonClicked",
				"title": "新任务",
				"icon": "$(add)"
			},
			{
				"command": "aiCode.mcpButtonClicked",
				"title": "MCP 服务器",
				"icon": "$(server)"
			},
			{
				"command": "aiCode.historyButtonClicked",
				"title": "历史记录",
				"icon": "$(history)"
			},
			{
				"command": "aiCode.settingsButtonClicked",
				"title": "设置",
				"icon": "$(settings-gear)"
			},
			{
				"command": "aiCode.dev.createTestTasks",
				"title": "创建测试任务",
				"category": "AI Code",
				"when": "aiCode.isDevMode"
			},
			{
				"command": "aiCode.dev.expireMcpOAuthTokens",
				"title": "使 MCP OAuth 令牌过期（用于测试）",
				"category": "AI Code",
				"when": "aiCode.isDevMode"
			},
			{
				"command": "aiCode.addToChat",
				"title": "添加到 AI Code",
				"category": "AI Code"
			},
			{
				"command": "aiCode.addTerminalOutputToChat",
				"title": "添加到 AI Code",
				"category": "AI Code"
			},
			{
				"command": "aiCode.focusChatInput",
				"title": "跳转到聊天输入",
				"category": "AI Code"
			},
			{
				"command": "aiCode.generateGitCommitMessage",
				"title": "使用 AI Code 生成提交信息",
				"category": "AI Code",
				"icon": "$(ai-code-icon)"
			},
			{
				"command": "aiCode.abortGitCommitMessage",
				"title": "使用 AI Code 生成提交信息 - 停止",
				"category": "AI Code",
				"icon": "$(debug-stop)"
			},
			{
				"command": "aiCode.explainCode",
				"title": "使用 AI Code 解释代码",
				"category": "AI Code"
			},
			{
				"command": "aiCode.improveCode",
				"title": "使用 AI Code 改进代码",
				"category": "AI Code"
			},
			{
				"command": "aiCode.jupyterGenerateCell",
				"title": "使用 AI Code 生成 Jupyter 单元格",
				"category": "AI Code",
				"icon": "$(sparkle)"
			},
			{
				"command": "aiCode.jupyterExplainCell",
				"title": "使用 AI Code 解释 Jupyter 单元格",
				"category": "AI Code",
				"icon": "$(question)"
			},
			{
				"command": "aiCode.jupyterImproveCell",
				"title": "使用 AI Code 改进 Jupyter 单元格",
				"category": "AI Code",
				"icon": "$(lightbulb)"
			},
			{
				"command": "aiCode.openWalkthrough",
				"title": "打开引导",
				"category": "AI Code"
			},
			{
				"command": "aiCode.reconstructTaskHistory",
				"title": "重建任务历史",
				"category": "AI Code"
			},
			{
				"command": "aiCode.reviewComment.reply",
				"title": "回复",
				"category": "AI Code",
				"enablement": "!commentIsEmpty"
			},
			{
				"command": "aiCode.reviewComment.addToChat",
				"title": "添加到 AI Code 聊天",
				"category": "AI Code",
				"icon": "$(link-external)"
			}
		],
		"keybindings": [
			{
				"command": "editor.action.submitComment",
				"key": "enter",
				"when": "commentEditorFocused && commentController == ai-code-review && !commentIsEmpty"
			},
			{
				"command": "aiCode.addToChat",
				"key": "cmd+'",
				"mac": "cmd+'",
				"win": "ctrl+'",
				"linux": "ctrl+'",
				"when": "editorHasSelection"
			},
			{
				"command": "aiCode.generateGitCommitMessage",
				"when": "config.git.enabled && scmProvider == git"
			},
			{
				"command": "aiCode.focusChatInput",
				"key": "cmd+'",
				"mac": "cmd+'",
				"win": "ctrl+'",
				"linux": "ctrl+'",
				"when": "!editorHasSelection"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "aiCode.plusButtonClicked",
					"group": "navigation@1",
					"when": "view == ai-code-dev.SidebarProvider"
				},
				{
					"command": "aiCode.mcpButtonClicked",
					"group": "navigation@2",
					"when": "view == ai-code-dev.SidebarProvider"
				},
				{
					"command": "aiCode.historyButtonClicked",
					"group": "navigation@3",
					"when": "view == ai-code-dev.SidebarProvider"
				},
				{
					"command": "aiCode.settingsButtonClicked",
					"group": "navigation@6",
					"when": "view == ai-code-dev.SidebarProvider"
				}
			],
			"editor/context": [
				{
					"command": "aiCode.addToChat",
					"group": "navigation",
					"when": "editorHasSelection"
				}
			],
			"terminal/context": [
				{
					"command": "aiCode.addTerminalOutputToChat",
					"group": "navigation"
				}
			],
			"scm/title": [
				{
					"command": "aiCode.generateGitCommitMessage",
					"group": "navigation",
					"when": "config.git.enabled && scmProvider == git && !aiCode.isGeneratingCommit"
				},
				{
					"command": "aiCode.abortGitCommitMessage",
					"group": "navigation",
					"when": "config.git.enabled && scmProvider == git && aiCode.isGeneratingCommit"
				}
			],
			"notebook/toolbar": [
				{
					"command": "aiCode.jupyterGenerateCell",
					"group": "navigation/add@1",
					"when": "notebookType == 'jupyter-notebook'"
				}
			],
			"notebook/cell/title": [
				{
					"command": "aiCode.jupyterExplainCell",
					"group": "inline@1",
					"when": "notebookType == 'jupyter-notebook'"
				},
				{
					"command": "aiCode.jupyterImproveCell",
					"group": "inline@2",
					"when": "notebookType == 'jupyter-notebook'"
				}
			],
			"commandPalette": [
				{
					"command": "aiCode.generateGitCommitMessage",
					"when": "config.git.enabled && !aiCode.isGeneratingCommit"
				},
				{
					"command": "aiCode.abortGitCommitMessage",
					"when": "config.git.enabled && aiCode.isGeneratingCommit"
				},
				{
					"command": "aiCode.reviewComment.reply",
					"when": "false"
				}
			],
			"comments/commentThread/context": [
				{
					"command": "aiCode.reviewComment.reply",
					"group": "inline",
					"when": "commentController == ai-code-review"
				}
			],
			"comments/commentThread/title": [
				{
					"command": "aiCode.reviewComment.addToChat",
					"group": "inline",
					"when": "commentController == ai-code-review"
				}
			]
		},
		"configuration": {
			"title": "AI Code",
			"properties": {}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run package",
		"compile": "npm run check-types && npm run lint && node esbuild.mjs",
		"compile-standalone": "npm run check-types && npm run lint && node esbuild.mjs --standalone",
		"postcompile-standalone": "node scripts/package-standalone.mjs",
		"dev": "npm run protos && npm run watch",
		"watch": "npx npm-run-all -p watch:*",
		"watch:esbuild": "node esbuild.mjs --watch",
		"watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
		"package": "npm run check-types && npm run build:webview && npm run lint && node esbuild.mjs --production",
		"protos": "node scripts/build-proto.mjs",
		"protos-python": "node scripts/build-python-proto.mjs",
		"download-ripgrep": "node scripts/download-ripgrep.mjs",
		"postprotos": "biome format --config-path ./biome.jsonc src/shared/proto src/generated webview-ui/src/services/grpc-client.ts --write --no-errors-on-unmatched",
		"clean:build": "rimraf dist dist-standalone webview-ui/build src/generated out/",
		"clean:deps": "rimraf node_modules webview-ui/node_modules",
		"clean:all": "npm run clean:build && npm run clean:deps",
		"compile-tests": "node ./scripts/build-tests.js",
		"watch-tests": "tsc -p . -w --outDir out",
		"check-types": "npm run protos && tsc --noEmit && cd webview-ui && tsc --noEmit",
		"lint": "biome lint --config-path ./biome.jsonc --no-errors-on-unmatched --files-ignore-unknown=true --diagnostic-level=error && npm run lint:proto",
		"lint:proto": "bash ./scripts/proto-lint.sh",
		"format": "biome format --config-path ./biome.jsonc --changed --since main --no-errors-on-unmatched --files-ignore-unknown=true --diagnostic-level=error",
		"format:fix": "biome check --config-path ./biome.jsonc --changed --since main --no-errors-on-unmatched --files-ignore-unknown=true --write",
		"fix:all": "biome check --config-path ./biome.jsonc --no-errors-on-unmatched --files-ignore-unknown=true --write --diagnostic-level=error --unsafe",
		"ci:check-all": "npx npm-run-all -p check-types lint format",
		"ci:build": "npm run protos && npm run build:webview && node esbuild.mjs && npm run compile-tests",
		"pretest": "npm run compile && npm run compile-tests && npm run compile-standalone && npm run lint",
		"test": "npx npm-run-all test:unit test:integration",
		"test:integration": "vscode-test",
		"test:unit": "cross-env TS_NODE_PROJECT=./tsconfig.unit-test.json mocha",
		"test:coverage": "vscode-test --coverage",
		"test:sca-server": "npx tsx watch scripts/test-standalone-core-api-server.ts",
		"test:tp-orchestrator": "npx tsx scripts/testing-platform-orchestrator.ts",
		"e2e": "playwright test -c playwright.config.ts",
		"test:e2e:build": "vsce package --allow-package-secrets sendgrid --out dist/e2e.vsix",
		"test:e2e": "playwright install && npm run test:e2e:build && node src/test/e2e/utils/build.mjs && playwright test",
		"test:e2e:optimal": "npm run test:e2e:build && node src/test/e2e/utils/build.mjs && playwright test",
		"test:e2e:ui": "npx tsx scripts/interactive-playwright.ts",
		"install:all": "npm install && cd webview-ui && npm install",
		"dev:webview": "cd webview-ui && npm run dev",
		"build:webview": "cd webview-ui && npm run build",
		"test:webview": "cd webview-ui && npm run test",
		"publish:marketplace": "node scripts/publish-marketplace.mjs",
		"publish:marketplace:prerelease": "node scripts/publish-marketplace.mjs --pre-release",
		"publish:marketplace:nightly": "node ./scripts/publish-nightly.mjs",
		"prepare": "npx husky",
		"docs": "cd docs && npm run dev",
		"docs:check-links": "cd docs && npm run check",
		"docs:rename-file": "cd docs && npm run rename",
		"report-issue": "node scripts/report-issue.js",
		"storybook": "cd webview-ui && npm run storybook",
		"eval:smoke:run": "npx tsx evals/smoke-tests/run-smoke-tests.ts"
	},
	"lint-staged": {
		"src/shared/storage/state-keys.ts": [
			"node scripts/generate-state-proto.mjs",
			"git add proto/cline/state.proto"
		],
		"*": [
			"biome check --write --staged --no-errors-on-unmatched --files-ignore-unknown=true"
		]
	},
