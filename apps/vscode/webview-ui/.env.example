# 设为 "true" 以在构建/开发时启用 webview UI 中文翻译。
# zh-cn-translate Vite 插件通过 loadEnv 读取此变量。
# 翻译定义在 apps/vscode/locales/zh-cn.json
CLINE_ZH_CN=true

# 设为 "true" 以在构建时隐藏 webview 中与 Cline 账户相关的 UI：
#   - 从 API 供应商下拉列表中移除 "Cline"（按量计费）和 "ClinePass" 供应商
#   - 无配置供应商时默认使用 deepseek
CLINE_HIDE_ACCOUNT=true

# 设为 "true" 以在构建时隐藏 webview 中的外部链接和遥测 UI：
#   - 隐藏"关于"页面的社区与支持、开发、资源链接
#   - 隐藏遥测设置并默认禁用
#   - 隐藏 MCP 服务器配置中的"了解更多"链接
#   - 隐藏 MCP 设置中的"查看演示"链接
#   - 隐藏自动批准设置中的"文档"链接
CLINE_HIDE_EXTERNAL_LINKS=true
