{
	"name": "claude-dev-china",
	"displayName": "AI Code: Cline, Chat, Deepseek, 中文版",
	"description": "在您的IDE中自动编码代理，能够在您的许可下创建/编辑文件、执行命令等等。支持deepseek模型",
	"version": "3.4.9",
	"icon": "assets/icons/icon.png",
	"galleryBanner": {
		"color": "#617A91",
		"theme": "dark"
	},
	"engines": {
		"vscode": "^1.84.0"
	},
	"author": {
		"name": "AI Code Bot Inc."
	},
	"license": "Apache-2.0",
	"publisher": "tianguaduizhang",
	"repository": {
		"type": "git",
		"url": "https://github.com/Ciciella/AI-Code"
	},
	"homepage": "https://github.com/Ciciella/AI-Code",
	"categories": [
		"AI",
		"Chat",
		"Programming Languages",
		"Education",
		"Snippets",
		"Testing"
	],
	"keywords": [
		"cline",
		"claude",
		"dev",
		"mcp",
		"openrouter",
		"coding",
		"agent",
		"autonomous",
		"chatgpt",
		"sonnet",
		"ai",
		"llama",
		"deepseek",
		"qinghua",
		"zhipu",
		"aicode",
		"ai code",
		"lingma",
		"roo code",
		"roocode"
	],
	"activationEvents": [],
	"main": "./dist/extension.js",
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "ai-code-dev-ActivityBar",
					"title": "AI Code",
					"icon": "assets/icons/icon.svg"
				}
			]
		},
		"views": {
			"ai-code-dev-ActivityBar": [
				{
					"type": "webview",
					"id": "ai-code-dev.SidebarProvider",
					"name": ""
				}
			]
		},
		"commands": [
			{
				"command": "aiCode.plusButtonClicked",
				"title": "新任务",
				"icon": "$(add)"
			},
			{
				"command": "aiCode.mcpButtonClicked",
				"title": "MCP服务器",
				"icon": "$(extensions)"
			},
			{
				"command": "aiCode.historyButtonClicked",
				"title": "历史记录",
				"icon": "$(history)"
			},
			{
				"command": "aiCode.popoutButtonClicked",
				"title": "在编辑器中打开",
				"icon": "$(link-external)"
			},
			{
				"command": "aiCode.settingsButtonClicked",
				"title": "设置",
				"icon": "$(settings-gear)"
			},
			{
				"command": "aiCode.openInNewTab",
				"title": "在新标签页中打开",
				"category": "AI Code"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "aiCode.plusButtonClicked",
					"group": "navigation@1",
					"when": "view == ai-code-dev.SidebarProvider"
				},
				{
					"command": "aiCode.mcpButtonClicked",
					"group": "navigation@2",
					"when": "view == ai-code-dev.SidebarProvider"
				},
				{
					"command": "aiCode.historyButtonClicked",
					"group": "navigation@3",
					"when": "view == ai-code-dev.SidebarProvider"
				},
				{
					"command": "aiCode.popoutButtonClicked",
					"group": "navigation@4",
					"when": "view == ai-code-dev.SidebarProvider"
				},
				{
					"command": "aiCode.settingsButtonClicked",
					"group": "navigation@5",
					"when": "view == ai-code-dev.SidebarProvider"
				}
			]
		},
		"configuration": {
			"title": "AI Code",
			"properties": {
				"aiCode.vsCodeLmModelSelector": {
					"type": "object",
					"properties": {
						"vendor": {
							"type": "string",
							"description": "语言模型的供应商（例如：copilot）"
						},
						"family": {
							"type": "string",
							"description": "语言模型的系列（例如：gpt-4）"
						}
					},
					"description": "VSCode 语言模型 API 的设置"
				},
				"aiCode.mcp.mode": {
					"type": "string",
					"enum": [
						"full",
						"server-use-only",
						"off"
					],
					"enumDescriptions": [
						"启用所有 MCP 功能（服务器使用和构建说明）",
						"仅启用 MCP 服务器使用（不包括构建 MCP 服务器的说明）",
						"禁用所有 MCP 功能"
					],
					"default": "full",
					"description": "控制在提示中包含 MCP 的内容，如果你只需要访问某些功能，可以减少令牌使用量。"
				},
				"aiCode.enableCheckpoints": {
					"type": "boolean",
					"default": true,
					"description": "允许扩展在任务执行过程中保存工作区的检查点。"
				},
				"aiCode.disableBrowserTool": {
					"type": "boolean",
					"default": false,
					"description": "禁用扩展程序生成浏览器会话。"
				},
				"aiCode.modelSettings.o3Mini.reasoningEffort": {
					"type": "string",
					"enum": [
						"low",
						"medium",
						"high"
					],
					"default": "medium",
					"description": "控制使用o3-mini模型时的推理努力。较高的值可能会导致更彻底但更慢的响应。"
				},
				"aiCode.chromeExecutablePath": {
					"type": "string",
					"default": null,
					"description": "用于浏览器功能的 Chrome 可执行文件路径。如果未设置，扩展将尝试自动查找或下载它。"
				},
				"aiCode.mcpMarketplace.enabled": {
					"type": "boolean",
					"default": true,
					"description": "控制是否启用 MCP 市场。"
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run package",
		"compile": "npm run check-types && npm run lint && node esbuild.js",
		"watch": "npm-run-all -p watch:*",
		"watch:esbuild": "node esbuild.js --watch",
		"watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
		"package": "npm run build:webview && npm run check-types && npm run lint && node esbuild.js --production",
		"compile-tests": "tsc -p ./tsconfig.test.json --outDir out",
		"watch-tests": "tsc -p . -w --outDir out",
		"pretest": "npm run compile-tests && npm run compile && npm run lint",
		"check-types": "tsc --noEmit",
		"lint": "eslint src --ext ts",
		"format": "prettier . --check",
		"format:fix": "prettier . --write",
		"test": "vscode-test",
		"install:all": "npm install && cd webview-ui && npm install",
		"start:webview": "cd webview-ui && npm run start",
		"build:webview": "cd webview-ui && npm run build",
		"test:webview": "cd webview-ui && npm run test",
		"publish:marketplace": "vsce publish && ovsx publish",
		"publish:marketplace:prerelease": "vsce publish --pre-release && ovsx publish --pre-release",
		"prepare": "husky",
		"changeset": "changeset",
		"version-packages": "changeset version"
	},
	"devDependencies": {
		"@changesets/cli": "^2.27.12",
		"@types/chai": "^5.0.1",
		"@types/diff": "^5.2.1",
		"@types/mocha": "^10.0.7",
		"@types/node": "20.x",
		"@types/should": "^11.2.0",
		"@types/vscode": "^1.84.0",
		"@typescript-eslint/eslint-plugin": "^7.14.1",
		"@typescript-eslint/parser": "^7.11.0",
		"@vscode/test-cli": "^0.0.9",
		"@vscode/test-electron": "^2.4.0",
		"chai": "^4.3.10",
		"esbuild": "^0.25.0",
		"eslint": "^8.57.0",
		"husky": "^9.1.7",
		"npm-run-all": "^4.1.5",
		"prettier": "^3.3.3",
		"should": "^13.2.3",
		"typescript": "^5.4.5"
	},
	"dependencies": {
		"@anthropic-ai/bedrock-sdk": "^0.10.2",
		"@anthropic-ai/sdk": "^0.26.0",
		"@anthropic-ai/vertex-sdk": "^0.4.1",
		"@google/generative-ai": "^0.18.0",
		"@mistralai/mistralai": "^1.5.0",
		"@modelcontextprotocol/sdk": "^1.0.1",
		"@types/clone-deep": "^4.0.4",
		"@types/get-folder-size": "^3.0.4",
		"@types/pdf-parse": "^1.1.4",
		"@types/turndown": "^5.0.5",
		"@vscode/codicons": "^0.0.36",
		"axios": "^1.7.4",
		"cheerio": "^1.0.0",
		"chokidar": "^4.0.1",
		"clone-deep": "^4.0.1",
		"default-shell": "^2.2.0",
		"delay": "^6.0.0",
		"diff": "^5.2.0",
		"execa": "^9.5.2",
		"fast-deep-equal": "^3.1.3",
		"firebase": "^11.2.0",
		"get-folder-size": "^5.0.0",
		"globby": "^14.0.2",
		"ignore": "^7.0.3",
		"isbinaryfile": "^5.0.2",
		"mammoth": "^1.8.0",
		"monaco-vscode-textmate-theme-converter": "^0.1.7",
		"openai": "^4.83.0",
		"os-name": "^6.0.0",
		"p-wait-for": "^5.0.2",
		"pdf-parse": "^1.1.1",
		"posthog-node": "^4.7.0",
		"puppeteer-chromium-resolver": "^23.0.0",
		"puppeteer-core": "^23.4.0",
		"serialize-error": "^11.0.3",
		"simple-git": "^3.27.0",
		"strip-ansi": "^7.1.0",
		"tree-sitter-wasms": "^0.1.11",
		"turndown": "^7.2.0",
		"web-tree-sitter": "^0.22.6",
		"zod": "^3.24.2"
	}
}
