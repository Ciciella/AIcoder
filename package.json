{
	"name": "claude-dev-china",
	"displayName": "AI Code: Cline, Chat, Deepseek, 中文版",
	"description": "在您的IDE中自动编码代理，能够在您的许可下创建/编辑文件、执行命令等等。支持deepseek模型",
	"version": "3.12.3",
	"icon": "assets/icons/icon.png",
	"engines": {
		"vscode": "^1.84.0"
	},
	"author": {
		"name": "AI Code Bot Inc."
	},
	"license": "Apache-2.0",
	"publisher": "tianguaduizhang",
	"repository": {
		"type": "git",
		"url": "https://github.com/Ciciella/AI-Code"
	},
	"homepage": "https://github.com/Ciciella/AI-Code",
	"categories": [
		"AI",
		"Chat",
		"Programming Languages",
		"Education",
		"Snippets",
		"Testing"
	],
	"keywords": [
		"cline",
		"claude",
		"dev",
		"mcp",
		"openrouter",
		"coding",
		"agent",
		"autonomous",
		"chatgpt",
		"sonnet",
		"ai",
		"llama",
		"deepseek",
		"qinghua",
		"zhipu",
		"aicode",
		"ai code",
		"lingma",
		"roo code",
		"roocode"
	],
	"activationEvents": [],
	"main": "./dist/extension.js",
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "ai-code-dev-ActivityBar",
					"title": "AI Code",
					"icon": "assets/icons/icon.svg"
				}
			]
		},
		"views": {
			"ai-code-dev-ActivityBar": [
				{
					"type": "webview",
					"id": "ai-code-dev.SidebarProvider",
					"name": ""
				}
			]
		},
		"commands": [
			{
				"command": "aiCode.plusButtonClicked",
				"title": "新任务",
				"icon": "$(add)"
			},
			{
				"command": "aiCode.mcpButtonClicked",
				"title": "MCP 服务器",
				"icon": "$(extensions)"
			},
			{
				"command": "aiCode.historyButtonClicked",
				"title": "历史记录",
				"icon": "$(history)"
			},
			{
				"command": "aiCode.popoutButtonClicked",
				"title": "在编辑器中打开",
				"icon": "$(link-external)"
			},
			{
				"command": "aiCode.accountButtonClicked",
				"title": "账户",
				"icon": "$(account)"
			},
			{
				"command": "aiCode.settingsButtonClicked",
				"title": "设置",
				"icon": "$(settings-gear)"
			},
			{
				"command": "aiCode.openInNewTab",
				"title": "在新标签页中打开",
				"category": "AI Code"
			},
			{
				"command": "aiCode.dev.createTestTasks",
				"title": "创建测试任务",
				"category": "AI Code",
				"when": "aiCode.isDevMode"
			},
			{
				"command": "aiCode.addToChat",
				"title": "添加到 AI Code",
				"category": "AI Code"
			},
			{
				"command": "aiCode.addTerminalOutputToChat",
				"title": "添加到 AI Code",
				"category": "AI Code"
			},
			{
				"command": "aiCode.fixWithCline",
				"title": "使用 AI Code 修复",
				"category": "AI Code"
			}
		],
		"keybindings": [
			{
				"command": "aiCode.addToChat",
				"key": "cmd+'",
				"mac": "cmd+'",
				"win": "ctrl+'",
				"linux": "ctrl+'",
				"when": "editorHasSelection"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "aiCode.plusButtonClicked",
					"group": "navigation@1",
					"when": "view == ai-code-dev.SidebarProvider"
				},
				{
					"command": "aiCode.mcpButtonClicked",
					"group": "navigation@2",
					"when": "view == ai-code-dev.SidebarProvider"
				},
				{
					"command": "aiCode.historyButtonClicked",
					"group": "navigation@3",
					"when": "view == ai-code-dev.SidebarProvider"
				},
				{
					"command": "aiCode.popoutButtonClicked",
					"group": "navigation@4",
					"when": "view == ai-code-dev.SidebarProvider"
				},
				{
					"command": "aiCode.accountButtonClicked",
					"group": "navigation@5",
					"when": "view == ai-code-dev.SidebarProvider && false"
				},
				{
					"command": "aiCode.settingsButtonClicked",
					"group": "navigation@6",
					"when": "view == ai-code-dev.SidebarProvider && false"
				}
			],
			"editor/title": [
				{
					"command": "aiCode.plusButtonClicked",
					"group": "navigation@1",
					"when": "activeWebviewPanelId == ai-code-dev.TabPanelProvider"
				},
				{
					"command": "aiCode.mcpButtonClicked",
					"group": "navigation@2",
					"when": "activeWebviewPanelId == ai-code-dev.TabPanelProvider"
				},
				{
					"command": "aiCode.historyButtonClicked",
					"group": "navigation@3",
					"when": "activeWebviewPanelId == ai-code-dev.TabPanelProvider"
				},
				{
					"command": "aiCode.popoutButtonClicked",
					"group": "navigation@4",
					"when": "activeWebviewPanelId == ai-code-dev.TabPanelProvider"
				},
				{
					"command": "aiCode.accountButtonClicked",
					"group": "navigation@5",
					"when": "activeWebviewPanelId == ai-code-dev.TabPanelProvider"
				},
				{
					"command": "aiCode.settingsButtonClicked",
					"group": "navigation@6",
					"when": "activeWebviewPanelId == ai-code-dev.TabPanelProvider"
				}
			],
			"editor/context": [
				{
					"command": "aiCode.addToChat",
					"group": "navigation",
					"when": "editorHasSelection"
				}
			],
			"terminal/context": [
				{
					"command": "aiCode.addTerminalOutputToChat",
					"group": "navigation"
				}
			]
		},
		"configuration": {
			"title": "AI Code",
			"properties": {
				"aiCode.vsCodeLmModelSelector": {
					"type": "object",
					"properties": {
						"vendor": {
							"type": "string",
							"description": "语言模型的供应商（例如：copilot）"
						},
						"family": {
							"type": "string",
							"description": "语言模型的系列（例如：gpt-4）"
						}
					},
					"description": "VSCode 语言模型 API 的设置"
				},
				"aiCode.enableCheckpoints": {
					"type": "boolean",
					"default": true,
					"description": "启用扩展在任务过程中保存工作区的检查点。使用底层的git，这可能不适用于大型工作区。"
				},
				"aiCode.disableBrowserTool": {
					"type": "boolean",
					"default": false,
					"description": "禁用扩展程序生成浏览器会话。"
				},
				"aiCode.modelSettings.o3Mini.reasoningEffort": {
					"type": "string",
					"enum": [
						"low",
						"medium",
						"high"
					],
					"default": "medium",
					"description": "控制使用o3-mini模型时的推理努力。较高的值可能会导致更彻底但更慢的响应。"
				},
				"aiCode.chromeExecutablePath": {
					"type": "string",
					"default": null,
					"description": "用于浏览器功能的 Chrome 可执行文件路径。如果未设置，扩展将尝试自动查找或下载它。"
				},
				"aiCode.preferredLanguage": {
					"type": "string",
					"enum": [
						"English",
						"Arabic - العربية",
						"Portuguese - Português (Brasil)",
						"Czech - Čeština",
						"French - Français",
						"German - Deutsch",
						"Hindi - हिन्दी",
						"Hungarian - Magyar",
						"Italian - Italiano",
						"Japanese - 日本語",
						"Korean - 한국어",
						"Polish - Polski",
						"Portuguese - Português (Portugal)",
						"Russian - Русский",
						"Simplified Chinese - 简体中文",
						"Spanish - Español",
						"Traditional Chinese - 繁體中文",
						"Turkish - Türkçe"
					],
					"default": "English",
					"description": "AI Code 应该使用的交流语言。"
				},
				"aiCode.mcpMarketplace.enabled": {
					"type": "boolean",
					"default": true,
					"description": "控制是否启用 MCP 市场。"
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run package",
		"compile": "npm run check-types && npm run lint && node esbuild.js",
		"watch": "npm-run-all -p watch:*",
		"watch:esbuild": "node esbuild.js --watch",
		"watch:esbuild:test": "IS_TEST=true node esbuild.js --watch",
		"watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
		"package": "npm run build:webview && npm run check-types && npm run lint && node esbuild.js --production",
		"protos": "node proto/build-proto.js && prettier src/shared/proto --write && prettier src/core/controller --write",
		"package:test": "IS_TEST=true npm run build:webview:test && npm run check-types && npm run lint && IS_TEST=true node esbuild.js --production",
		"build:webview:test": "cd webview-ui && IS_TEST=true npm run build",
		"watch:test": "IS_TEST=true npm-run-all -p watch:tsc watch:esbuild:test",
		"compile-tests": "tsc -p ./tsconfig.test.json --outDir out",
		"watch-tests": "tsc -p . -w --outDir out",
		"pretest": "npm run compile-tests && npm run compile && npm run lint",
		"check-types": "tsc --noEmit",
		"lint": "eslint src --ext ts && eslint webview-ui/src --ext ts",
		"format": "prettier . --check",
		"format:fix": "prettier . --write",
		"test": "npm-run-all test:unit test:integration",
		"test:ci": "node scripts/test-ci.js",
		"test:integration": "vscode-test",
		"test:unit": "TS_NODE_PROJECT='./tsconfig.unit-test.json' mocha",
		"test:coverage": "vscode-test --coverage",
		"install:all": "npm install && cd webview-ui && npm install",
		"dev:webview": "cd webview-ui && npm run dev",
		"build:webview": "cd webview-ui && npm run build",
		"test:webview": "cd webview-ui && npm run test",
		"publish:marketplace": "vsce publish && ovsx publish",
		"publish:marketplace:prerelease": "vsce publish --pre-release && ovsx publish --pre-release",
		"prepare": "husky",
		"changeset": "changeset",
		"version-packages": "changeset version"
	},
	"devDependencies": {
		"@changesets/cli": "^2.27.12",
		"@types/chai": "^5.0.1",
		"@types/clone-deep": "^4.0.4",
		"@types/diff": "^5.2.1",
		"@types/get-folder-size": "^3.0.4",
		"@types/mocha": "^10.0.7",
		"@types/node": "20.x",
		"@types/pdf-parse": "^1.1.4",
		"@types/proxyquire": "^1.3.31",
		"@types/should": "^11.2.0",
		"@types/sinon": "^17.0.4",
		"@types/turndown": "^5.0.5",
		"@types/vscode": "^1.84.0",
		"@typescript-eslint/eslint-plugin": "^7.14.1",
		"@typescript-eslint/parser": "^7.11.0",
		"@vscode/test-cli": "^0.0.9",
		"@vscode/test-electron": "^2.4.0",
		"chai": "^4.3.10",
		"chalk": "^5.3.0",
		"esbuild": "^0.25.0",
		"eslint": "^8.57.0",
		"husky": "^9.1.7",
		"npm-run-all": "^4.1.5",
		"prettier": "^3.3.3",
		"protoc-gen-ts": "^0.8.7",
		"proxyquire": "^2.1.3",
		"should": "^13.2.3",
		"sinon": "^19.0.2",
		"ts-node": "^10.9.2",
		"ts-proto": "^2.6.1",
		"typescript": "^5.4.5"
	},
	"dependencies": {
		"@anthropic-ai/bedrock-sdk": "^0.12.4",
		"@anthropic-ai/sdk": "^0.37.0",
		"@anthropic-ai/vertex-sdk": "^0.6.4",
		"@aws-sdk/client-bedrock-runtime": "^3.758.0",
		"@bufbuild/protobuf": "^2.2.5",
		"@google-cloud/vertexai": "^1.9.3",
		"@google/generative-ai": "^0.18.0",
		"@grpc/grpc-js": "^1.9.15",
		"@mistralai/mistralai": "^1.5.0",
		"@modelcontextprotocol/sdk": "^1.7.0",
		"@opentelemetry/api": "^1.4.1",
		"@opentelemetry/exporter-trace-otlp-http": "^0.39.1",
		"@opentelemetry/resources": "^1.30.1",
		"@opentelemetry/sdk-node": "^0.39.1",
		"@opentelemetry/sdk-trace-node": "^1.30.1",
		"@opentelemetry/semantic-conventions": "^1.30.0",
		"@sentry/browser": "^9.12.0",
		"@vscode/codicons": "^0.0.36",
		"axios": "^1.8.2",
		"cheerio": "^1.0.0",
		"chokidar": "^4.0.1",
		"chrome-launcher": "^1.1.2",
		"clone-deep": "^4.0.1",
		"default-shell": "^2.2.0",
		"diff": "^5.2.0",
		"execa": "^9.5.2",
		"fast-deep-equal": "^3.1.3",
		"firebase": "^11.2.0",
		"fzf": "^0.5.2",
		"get-folder-size": "^5.0.0",
		"globby": "^14.0.2",
		"ignore": "^7.0.3",
		"isbinaryfile": "^5.0.2",
		"mammoth": "^1.8.0",
		"monaco-vscode-textmate-theme-converter": "^0.1.7",
		"ollama": "^0.5.13",
		"open-graph-scraper": "^6.9.0",
		"openai": "^4.83.0",
		"os-name": "^6.0.0",
		"p-timeout": "^6.1.4",
		"p-wait-for": "^5.0.2",
		"pdf-parse": "^1.1.1",
		"posthog-node": "^4.8.1",
		"puppeteer-chromium-resolver": "^23.0.0",
		"puppeteer-core": "^23.4.0",
		"serialize-error": "^11.0.3",
		"simple-git": "^3.27.0",
		"strip-ansi": "^7.1.0",
		"tree-sitter-wasms": "^0.1.11",
		"turndown": "^7.2.0",
		"web-tree-sitter": "^0.22.6",
		"zod": "^3.24.2"
	}
}